# =============================================================================
# sfh-orchestrator — variables de entorno (NO versionar el .env real)
# =============================================================================
NODE_ENV=development
API_PORT=8080

# Base de datos (Cloud SQL vía conector/proxy). Sin secretos en repo.
DATABASE_URL=postgresql://app:<PASSWORD>@127.0.0.1:5433/truekeate

# Blockchain
RPC_URL=https://besu.alumnos.codecrypto.academy
CHAIN_ID=81234
SUPER_TOKEN_ADDRESS=
UNDERLYING_ADDRESS=

# Ejecución (D42/D43/D44)
INDEXER_POLL_MS=60000
HEALTHCHECK_MS=60000
INDEXER_CONFIRMATIONS=2
INDEXER_REORG_WINDOW=12
REVOCATION_SLA_MS=10000
PROVISIONAL_SECONDS=60
MEMPOOL_MODE=receipt

# Cloud Tasks (D44). Vacío = cola en memoria (solo dev/test)
CLOUD_TASKS_PROJECT=
CLOUD_TASKS_LOCATION=europe-west1
CLOUD_TASKS_QUEUE_AUTH=authorize-validation
CLOUD_TASKS_QUEUE_EXPIRY=provisional-expiry
INTERNAL_BASE_URL=http://localhost:8080

# Seguridad (referencias; en producción desde Secret Manager)
JWT_SECRET=cambia-este-secreto-en-produccion-32chars
INTERNAL_SECRET=cambia-este-secreto-interno
API_KEY_PEPPER=cambia-este-pepper-en-produccion
GATEWAY_HMAC_SECRETS=gid-demo=secreto-demo-cambiame
# JSON de adaptadores por gateway (H3). En prod se deriva de BD + Secret Manager.
GATEWAY_RUNTIME_CONFIGS=[]
BIND_TOKEN_TTL_SECONDS=300
BIND_HMAC_WINDOW_SECONDS=60
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=900000
