# sfh-portal — imagen Next.js standalone (Cloud Run)
FROM node:22-alpine AS deps
WORKDIR /app
COPY package*.json ./
# next 15 declara @playwright/test como peer; el lock resuelve 1.49.1.
RUN npm ci --legacy-peer-deps

FROM node:22-alpine AS build
WORKDIR /app
ARG NEXT_PUBLIC_API_URL=http://localhost:8080
ARG NEXT_PUBLIC_RPC_URL=https://besu.alumnos.codecrypto.academy
ARG NEXT_PUBLIC_CHAIN_ID=81234
ARG NEXT_PUBLIC_BRLT_ADDRESS
ARG NEXT_PUBLIC_BRLTX_ADDRESS
ARG NEXT_PUBLIC_PAYOUT_WALLET
ARG NEXT_PUBLIC_PRICE_PER_SECOND_WEI=500000000000000
ARG NEXT_PUBLIC_BANDWIDTH_DOWN_BPS=50000000
ARG NEXT_PUBLIC_BANDWIDTH_UP_BPS=10000000
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_RPC_URL=$NEXT_PUBLIC_RPC_URL \
    NEXT_PUBLIC_CHAIN_ID=$NEXT_PUBLIC_CHAIN_ID \
    NEXT_PUBLIC_BRLT_ADDRESS=$NEXT_PUBLIC_BRLT_ADDRESS \
    NEXT_PUBLIC_BRLTX_ADDRESS=$NEXT_PUBLIC_BRLTX_ADDRESS \
    NEXT_PUBLIC_PAYOUT_WALLET=$NEXT_PUBLIC_PAYOUT_WALLET \
    NEXT_PUBLIC_PRICE_PER_SECOND_WEI=$NEXT_PUBLIC_PRICE_PER_SECOND_WEI \
    NEXT_PUBLIC_BANDWIDTH_DOWN_BPS=$NEXT_PUBLIC_BANDWIDTH_DOWN_BPS \
    NEXT_PUBLIC_BANDWIDTH_UP_BPS=$NEXT_PUBLIC_BANDWIDTH_UP_BPS
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build

FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
EXPOSE 3000
CMD ["node", "server.js"]
