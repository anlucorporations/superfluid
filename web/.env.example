# Copiar a `web/.env.local` (ignorado por git).

# --- MongoDB ---
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=superfluid

# --- Red Besu Codecrypto ---
NEXT_PUBLIC_RPC_URL=https://besu.alumnos.codecrypto.academy
NEXT_PUBLIC_CHAIN_ID=81234
NEXT_PUBLIC_BRLT_ADDRESS=
NEXT_PUBLIC_BRLTX_ADDRESS=
NEXT_PUBLIC_FAUCET_URL=https://faucet.codecrypto.academy/

# --- SIWE ---
# Dominio esperado en el mensaje SIWE (sin esquema ni puerto). En local: localhost:3000
SIWE_DOMAIN=localhost:3000
# Tiempo de vida del nonce SIWE (segundos)
SIWE_NONCE_TTL_SECONDS=300
# Sesiones
SESSION_TTL_ADMIN_SECONDS=7200
SESSION_TTL_EMPLOYEE_SECONDS=28800
# Rate limit de login
AUTH_RATE_LIMIT=5
AUTH_RATE_WINDOW_SECONDS=900

# --- Bootstrap ---
# Wallet que se inserta en admin_allowlist al ejecutar `npm run seed`.
ADMIN_BOOTSTRAP_WALLET=

# --- Jobs (H6) ---
# `1` desactiva el cron interno en este proceso (útil en smokes/dev)
DISABLE_JOBS=0

# --- Tests de integración (opcional) ---
# MONGODB_URI_TEST=mongodb://127.0.0.1:27017
