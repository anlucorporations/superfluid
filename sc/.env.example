# Copiar a `sc/.env` (ignorado por git) y rellenar.
# Foundry carga automáticamente `sc/.env` al ejecutar `forge script`.

# --- Despliegue (H2) ---
# Wallet administrativa final: será owner y minter de BRLT y owner de BrltX.
ADMIN_PRIVATE_KEY=
# Clave efímera de despliegue (opcional). Si se omite se usa la del admin.
DEPLOYER_PRIVATE_KEY=
# Receptor del supply inicial (opcional; por defecto, la wallet admin).
INITIAL_HOLDER=

# --- Verificación de un despliegue existente ---
BRLT_ADDRESS=
BRLTX_ADDRESS=
ADMIN_ADDRESS=
DEPLOY_BLOCK=

# --- Red ---
RPC_URL=https://besu.alumnos.codecrypto.academy
CHAIN_ID=81234
