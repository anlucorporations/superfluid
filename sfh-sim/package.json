{
  "name": "sfh-sim",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Emulador de gateway MikroTik (RouterOS v7 REST) y NAS/hotspot para el entorno de pruebas de SFhostpot",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.mjs",
    "nas": "node nas-sim.mjs",
    "test": "node --test test/*.test.mjs",
    "spike": "node prototipo/validar.mjs",
    "scenarios": "node scenario-runner/run.mjs",
    "ci": "node --test test/*.test.mjs && node prototipo/validar.mjs"
  },
  "dependencies": {
    "pg": "^8.13.1"
  }
}
